# Copy to .env for local development. Never commit real values.
# Meta app dashboard: https://developers.facebook.com/apps
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must EXACTLY match a Valid OAuth Redirect URI registered in your Meta app.
# Local default: http://localhost:5175/api/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Required in production: a random string of at least 32 characters.
SESSION_SECRET=
# Optional: Facebook Graph API version used for OAuth and Instagram messaging.
GRAPH_API_VERSION=v21.0
# Server-side only. /api/analyze-chat prefers Gemini, then OpenAI.
GEMINI_API_KEY=
OPENAI_API_KEY=
